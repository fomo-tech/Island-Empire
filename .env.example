MONGO_URI=mongodb://127.0.0.1:27017/island_empire
PORT=4000
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:5173,http://localhost:5174,http://localhost:5175
JWT_SECRET=change-this-long-random-secret
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
REDIS_URL=redis://127.0.0.1:6379/0
# Set true only when Node is reachable exclusively through the Nginx gateway below.
TRUST_PROXY=false
# Generate a different random value for production; never expose it to the browser.
ANTI_BOT_SECRET=change-this-to-a-long-random-server-only-secret
