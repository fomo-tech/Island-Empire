# Copy to apps/server/.env on the VPS and replace every placeholder.
NODE_ENV=production
HOST=127.0.0.1
PORT=4001
MONGO_URI=mongodb://127.0.0.1:27017/island_empire
CORS_ORIGIN=https://game.example.com
TRUST_PROXY=true
JWT_SECRET=replace_with_a_unique_32_byte_secret
ANTI_BOT_SECRET=replace_with_a_different_unique_32_byte_secret
ADMIN_USER=admin
ADMIN_PASSWORD=replace_with_a_strong_admin_password
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=game.example.com
SHOP_TEST_MODE=false
